require_relative "xcodeproj_patch"
require_relative "study_variant"

default_platform(:ios)

APP_CONFIG = {
  default_environment: "staging",
  default_app_identifier: "edu.stanford.MyHeartCounts",
  default_secondary_app_identifier: "edu.stanford.MyHeartCounts.watchkitapp",
  default_provisioningProfile: "My Heart Counts",
  default_secondary_provisioningProfile: "My Heart Counts - Watch",
  default_version_name: "4.0.0",
  default_release_notes: "Bug fixes and performance improvements.",
  scheme: "MyHeartCounts",
  xcodeproj: "MyHeartCounts.xcodeproj",
  plist_path: "MyHeartCounts/Supporting Files/Info.plist"
}.freeze

platform :ios do
  before_all do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "5"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "6"
  end

  desc "Build and Test UI Tests"
  lane :uitest do
    run_tests(
      scheme: "MyHeartCounts",
      skip_build: true,
      testplan: "MyHeartCounts UI Tests",
      derived_data_path: ".derivedData",
      code_coverage: true,
      # NOTE: intentionally no OS version pin here. already one by the gh workflow.
      # NOTE: also intentionally not using the max phone, so we make sure the app works on the smaller screen.
      devices: ["iPhone 18 Pro"],
      disable_slide_to_type: false,
      concurrent_workers: 1,
      max_concurrent_simulators: 1,
      result_bundle: true,
      result_bundle_path: "./MHC-App-UITests.xcresult",
      output_directory: ".",
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation"
      ]
    )
  end

  desc "Screenshots"
  lane :screenshots do
    run_tests(
      scheme: "MyHeartCounts",
      destination: "generic/platform=iOS Simulator",
      configuration: "Debug",
      derived_data_path: ".derivedData",
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation"
      ],
      build_for_testing: true
    )

    snapshot(
      test_without_building: true,
      derived_data_path: ".derivedData",
      devices: [
        "iPhone 18 Pro Max",
        "iPad Pro 13-inch (M5)"
      ],
      languages: [
         "en-US",
      ],
      scheme: APP_CONFIG[:scheme],
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      concurrent_simulators: false,
      stop_after_first_error: true,
      skip_open_summary: true
    )
    
    # Workaround for https://github.com/fastlane/fastlane/issues/21759 
    Dir.glob("./screenshots/**/iPhone 18 Pro Max-*.png").each do |file|
      sh("sips --resampleHeightWidth 2796 1290 '#{file}'")
    end
  end

  desc "Build app"
  lane :build do
    build_app(
      scheme: APP_CONFIG[:scheme],
      skip_archive: true,
      skip_codesigning: true,
      derived_data_path: ".derivedData",
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation"
      ]
    )
  end

  desc "Archive app"
  lane :archive do |options|
    appidentifier = options[:appidentifier].to_s.strip.empty? ? APP_CONFIG[:default_app_identifier] : options[:appidentifier]
    secondaryAppIdentifier = options[:secondaryAppidentifier].to_s.strip.empty? ? APP_CONFIG[:default_secondary_app_identifier] : options[:secondaryAppidentifier]
    provisioningProfile = options[:provisioningProfile].to_s.strip.empty? ? APP_CONFIG[:default_provisioningProfile] : options[:provisioningProfile]
    secondaryProvisioningProfile = options[:secondaryProvisioningProfile].to_s.strip.empty? ? APP_CONFIG[:default_secondary_provisioningProfile] : options[:secondaryProvisioningProfile]

    update_app_identifier(
      plist_path: APP_CONFIG[:plist_path],
      app_identifier: appidentifier
    )

    build_app(
      scheme: APP_CONFIG[:scheme],
      output_name: options[:output_name].to_s.strip.empty? ? APP_CONFIG[:scheme] : options[:output_name],
      derived_data_path: ".derivedData",
      skip_profile_detection: true,
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation"
      ],
      export_options: {
        provisioningProfiles: {
          appidentifier => provisioningProfile,
          secondaryAppIdentifier => secondaryProvisioningProfile
        }
      }
    )
  end

  desc "Sign in to the App Store Connect API"
  lane :signin do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_BASE64"],
      is_key_content_base64: true
    )
  end

  desc "Publish a release to TestFlight or the App Store depending on the environment"
  lane :deploy do |options|
    environment = options[:environment].to_s.strip.empty? ? APP_CONFIG[:default_environment] : options[:environment]
    appidentifier = options[:appidentifier].to_s.strip.empty? ? APP_CONFIG[:default_app_identifier] : options[:appidentifier]
    secondaryAppIdentifier = options[:secondaryAppidentifier].to_s.strip.empty? ? APP_CONFIG[:default_secondary_app_identifier] : options[:secondaryAppidentifier]
    provisioningProfile = options[:provisioningProfile].to_s.strip.empty? ? APP_CONFIG[:default_provisioningProfile] : options[:provisioningProfile]
    secondaryProvisioningProfile = options[:secondaryProvisioningProfile].to_s.strip.empty? ? APP_CONFIG[:default_secondary_provisioningProfile] : options[:secondaryProvisioningProfile]
    versionname = options[:versionname].to_s.strip.empty? ? APP_CONFIG[:default_version_name] : options[:versionname]
    releasenotes = options[:releasenotes].to_s.strip.empty? ? APP_CONFIG[:default_release_notes] : options[:releasenotes]
    strip_sensorkit_entitlement = options[:strip_sensorkit_entitlement].to_s == "true"
    # The explicit build number is for the Stanford build; every other build takes the next free number.
    stanford_buildnumber = options[:buildnumber].to_s.strip
    # TestFlight deployments always ship both study variants. Imperial builds are TestFlight-only.
    variants = environment == "production" ? ["stanford"] : ["stanford", "imperial"]

    unless stanford_buildnumber.empty? || (stanford_buildnumber.match?(/\A\d+\z/) && stanford_buildnumber.to_i.even?)
      UI.user_error!("Stanford builds need an even build number, got '#{stanford_buildnumber}'.")
    end

    UI.message("Using environment: #{environment}")
    UI.message("Using study variants: #{variants.join(", ")}")
    UI.message("Using app identifier: #{appidentifier}")
    UI.message("Using secondary app identifier: #{secondaryAppIdentifier}")
    UI.message("Using provisioning profile: #{provisioningProfile}")
    UI.message("Using secondary provisioning profile: #{secondaryProvisioningProfile}")
    UI.message("Using version name: #{versionname}")
    UI.message("Using release notes: #{releasenotes}")

    releasenotes = releasenotes.gsub('\u2019', "'")

    currentversion = get_version_number(
      xcodeproj: APP_CONFIG[:xcodeproj],
      target: APP_CONFIG[:scheme]
    )
    UI.message("Current version: #{currentversion}")

    if Gem::Version.new(versionname) > Gem::Version.new(currentversion)
      increment_version_number(
        xcodeproj: APP_CONFIG[:xcodeproj],
        version_number: versionname
      )
      UI.message("Version bumped to #{versionname}.")
    else
      UI.message("No version bump needed. Current version (#{currentversion}) is greater than or equal to desired version (#{versionname}).")
    end
    
    signin

    if strip_sensorkit_entitlement
      puts 'Stripping SensorKit entitlement'
      sh('plutil', '-remove', 'com\.apple\.developer\.sensorkit\.reader\.allow', '../MyHeartCounts/Supporting Files/MyHeartCounts.entitlements')
    end

    # Archive every variant before uploading any of them, so that a variant that fails to compile stops the deployment
    # before anything reaches App Store Connect.
    # Stanford builds always get even build numbers, Imperial builds odd ones.
    highest_buildnumber = latest_testflight_build_number(
      app_identifier: appidentifier
    )
    builds = variants.map do |variant|
      if variant == "stanford" && !stanford_buildnumber.empty?
        buildnumber = stanford_buildnumber.to_i
      else
        buildnumber = highest_buildnumber + 1
        buildnumber += 1 unless buildnumber % 2 == (variant == "imperial" ? 1 : 0)
      end
      highest_buildnumber = [highest_buildnumber, buildnumber].max
      UI.message("Archiving the #{variant} variant as build #{buildnumber}.")
      increment_build_number(
        build_number: buildnumber
      )

      with_forced_study_variant(File.expand_path("../#{APP_CONFIG[:plist_path]}", __dir__), variant) do
        archive(
          appidentifier: appidentifier,
          secondaryAppIdentifier: secondaryAppIdentifier,
          provisioningProfile: provisioningProfile,
          secondaryProvisioningProfile: secondaryProvisioningProfile,
          output_name: "#{APP_CONFIG[:scheme]}-#{variant}",
        )
      end
      ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
      {
        variant: variant,
        ipa: ipa,
        version: FastlaneCore::IpaFileAnalyser.fetch_app_version(ipa),
        buildnumber: FastlaneCore::IpaFileAnalyser.fetch_app_build(ipa)
      }
    end
    commit = last_git_commit
    
    if environment == "production"
      deliver(
        app_identifier: appidentifier,
        ipa: builds.first[:ipa],
        release_notes: {
          'en-US' => releasenotes,
          'en-GB' => releasenotes,
          'es-ES' => releasenotes
        },
        overwrite_screenshots: true,
        submit_for_review: true,
        force: true,
        reject_if_possible: true,
        automatic_release: true,
        precheck_include_in_app_purchases: false,
      )
    else
      changelogs = {
        "stanford" => commit[:message],
        "imperial" => "[UK] #{commit[:message]}"
      }
      testflight_groups = {
        "stanford" => environment == "development" ? "Development" : "External Testers (Stanford)",
        "imperial" => "External Testers (Imperial)"
      }

      # Upload every build and wait until App Store Connect has processed it, without handing it to any testers yet.
      builds.each do |build|
        upload_to_testflight(
          app_identifier: appidentifier,
          ipa: build[:ipa],
          skip_submission: true,
          changelog: changelogs[build[:variant]]
        )
      end

      # Only now that every variant is on TestFlight do the builds go out to the testers.
      builds.each_with_index do |build, index|
        upload_to_testflight(
          app_identifier: appidentifier,
          distribute_only: true,
          app_version: build[:version],
          build_number: build[:buildnumber],
          distribute_external: true,
          # Pilot expires *any* build of this version that is waiting for beta review.
          # Only the first build may do that, otherwise it would expire the builds this run has just submitted.
          reject_build_waiting_for_review: index.zero?,
          expire_previous_builds: false,
          groups: [
            testflight_groups[build[:variant]]
          ],
          submit_beta_review: true,
          notify_external_testers: true,
          changelog: changelogs[build[:variant]]
        )
      end
    end
  end
end
